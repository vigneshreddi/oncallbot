# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Values here are placeholders only.

# LLM provider: anthropic | openai | ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_API_KEY=
# Ollama or OpenAI-compatible base URL. Leave empty for the provider default.
LLM_BASE_URL=http://host.docker.internal:11434/v1

# Embeddings for the code index: openai | ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1

# GitHub read token for fetching code at prod_commit (fine-grained, read-only). Optional for the local demo.
GITHUB_TOKEN=

# Optional human-reviewed draft PRs against pr_target_branch (main). Disabled unless exactly "true".
FIX_PR_ENABLED=
# auto: the investigator opens the AI-written fix as a draft PR when the investigation ends.
# approve: it stores the proposal and waits for POST /incidents/<id>/open-pr.
FIX_PR_MODE=auto
# Separate fine-grained token: Contents and Pull requests write on allowlisted repositories only.
GITHUB_WRITE_TOKEN=
# HTTPS investigator evidence base URL, without userinfo, query strings, or fragments.
FIX_EVIDENCE_BASE_URL=

# Database passwords are generated into the postgres-secret by scripts/up.ps1; never set them here.

# Log queries: kubernetes (default) | datadog | loki | splunk
LOG_PROVIDER=kubernetes
# Lookback in seconds, clamped to 1..86400. Results are capped at 200.
LOG_QUERY_WINDOW_SECONDS=900
LOG_HTTP_TIMEOUT_SECONDS=30

# Datadog logs_read API/application keys; site is an allowlisted Datadog domain.
DATADOG_SITE=datadoghq.com
DATADOG_API_KEY=
DATADOG_APP_KEY=

# Operator-configured HTTPS endpoint. Basic auth OR bearer token, never both.
LOKI_BASE_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TOKEN=
LOKI_TENANT_ID=

# Operator-configured HTTPS management endpoint (including port if required).
# Read-only search token scoped to SPLUNK_INDEX; no write/admin capabilities.
SPLUNK_BASE_URL=
SPLUNK_TOKEN=
SPLUNK_INDEX=main
